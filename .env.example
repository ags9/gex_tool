# ── gexbot configuration ──────────────────────────────────────────────
# Comments must be on their own lines. No ${VAR} interpolation.

# Massive (Polygon) — flat-file S3 creds come from the dashboard's
# "Flat Files" section. The S3 secret is the same string as the API key
# (normal); the S3 Access Key ID is distinct.
MASSIVE_API_KEY=your_key_here
MASSIVE_S3_ACCESS_KEY=your_s3_access_key
MASSIVE_S3_SECRET_KEY=your_s3_secret_key
MASSIVE_S3_ENDPOINT=https://files.polygon.io
MASSIVE_S3_BUCKET=flatfiles

# Storage root on the Thunderbolt drive — set to your actual volume name.
# raw/, parquet/, and manifest.duckdb are derived automatically underneath it.
GEX_DATA_ROOT=/Volumes/YourDriveName/gexbot-data

# Option roots to keep (SPXW = SPX weeklys/0DTE)
GEX_UNDERLYINGS=SPX,SPXW,XSP,SPY
GEX_INDEX_TICKERS=I:SPX,I:VIX,I:VIX9D,I:VVIX

GEX_START_DATE=2021-01-04
# Leave GEX_END_DATE empty to mean "yesterday"
GEX_END_DATE=

# Non-standard ports (avoid collisions with other dev work on this machine)
GEX_DASHBOARD_PORT=8741
GEX_API_PORT=8742

# Discord webhooks — channel gear -> Integrations -> Webhooks -> copy URL
DISCORD_WEBHOOK_TRADES=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_DAILY=

# Schwab Trader API (fill when the app reaches "Ready for use")
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Anthropic (news classifier — paper-trading phase, optional)
ANTHROPIC_API_KEY=
