# ── gexbot configuration ──────────────────────────────────────────────
# Copy to .env and fill in. Nothing here is ever hardcoded in source.

# Massive (Polygon) — flat files use S3-style keys; API key doubles as S3 creds
MASSIVE_API_KEY=your_key_here
MASSIVE_S3_ACCESS_KEY=your_s3_access_key      # from massive.com dashboard -> Flat Files
MASSIVE_S3_SECRET_KEY=your_s3_secret_key
MASSIVE_S3_ENDPOINT=https://files.polygon.io  # legacy endpoint still valid post-rebrand
MASSIVE_S3_BUCKET=flatfiles

# Storage (Thunderbolt drive) — raw downloads are deleted after conversion
GEX_DATA_ROOT=/Volumes/TB-SSD/gexbot-data
GEX_RAW_DIR=${GEX_DATA_ROOT}/raw              # transient; auto-cleaned
GEX_PARQUET_DIR=${GEX_DATA_ROOT}/parquet      # permanent, date-partitioned
GEX_MANIFEST_DB=${GEX_DATA_ROOT}/manifest.duckdb

# Universe
GEX_UNDERLYINGS=SPX,SPXW,XSP,SPY              # option roots to keep (SPXW = SPX weeklys/0DTE)
GEX_INDEX_TICKERS=I:SPX,I:VIX,I:VIX9D,I:VVIX

# History window
GEX_START_DATE=2021-01-04
GEX_END_DATE=                                  # empty = yesterday

# Non-standard ports (avoid collisions with other dev work on this machine)
GEX_DASHBOARD_PORT=8741
GEX_API_PORT=8742

# Discord (Phase 2 — leave blank for now)
DISCORD_WEBHOOK_TRADES=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_DAILY=
